# Copy to .env (next to this file or in backend/). Every value has a development default.
ENV=development
# Origins allowed to call the API from a browser (the Next.js app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite+aiosqlite:///./supportdesk.db

# Discord bot (python -m app.bot). Leave empty to run only the API and dashboard.
DISCORD_BOT_TOKEN=
